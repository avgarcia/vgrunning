# Keep source and build scripts portable even when core.autocrlf is enabled.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.gitkeep text eol=lf
*.npmrc text eol=lf
*.bat text eol=crlf
gradlew text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
gradle/wrapper/gradle-wrapper.jar binary
