# Valores exclusivos para desarrollo local. No copies secretos reales a .env.
RUNNING_COACH_DB_PORT=5432
RUNNING_COACH_DB_URL=jdbc:postgresql://localhost:5432/running_coach
RUNNING_COACH_DB_USERNAME=running_coach
RUNNING_COACH_DB_PASSWORD=running_coach

# Clave Base64 de al menos 32 bytes, exclusiva de este entorno sintético local.
# Genera y rota una distinta antes de cualquier entorno no local.
PMV_IDENTITY_RATE_LIMIT_HMAC_KEY=QmFzZTY0LXN5bnRoZXRpYy1sb2NhbC1obWFjLWtleS0zMi1ieXRlcw==
PMV_IDENTITY_SECURITY_EVENT_RETENTION=PT2160H

# Datos sintéticos opt-in. Para provisionarlos, activa ambos perfiles:
# SPRING_PROFILES_ACTIVE=local,synthetic-accounts
PMV_IDENTITY_SYNTHETIC_ADMINISTRATOR_PASSWORD=synthetic-admin-password-only
PMV_IDENTITY_SYNTHETIC_RUNNER_PASSWORD=synthetic-runner-password-only
