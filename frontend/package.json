{
  "name": "@vgrunning/running-coach-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "axios": "1.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@stoplight/spectral-cli": "6.16.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "api:lint": "spectral lint --ruleset ../api/openapi/.spectral.yaml ../api/openapi/running-coach.yaml",
    "api:verify-spectral": "node scripts/verify-spectral-negative-cases.cjs",
    "api:typecheck": "tsc --project tsconfig.api.json --noEmit",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit"
  }
}
